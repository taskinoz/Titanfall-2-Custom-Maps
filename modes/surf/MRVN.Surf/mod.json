{
    "Name": "MRVN.Surf",
    "Description": "Surf: race down surf maps for the fastest time. No teams, surf movement settings applied for you, no time limit, timed runs with a web leaderboard.",
    "Version": "0.1.0",
    "LoadPriority": 2,
    "RequiredOnClient": true,
    "ConVars": [
        {
            "Name": "surf_leaderboard_url",
            "DefaultValue": ""
        },
        {
            "Name": "surf_leaderboard_key",
            "DefaultValue": ""
        },
        {
            "Name": "surf_save_scores",
            "DefaultValue": "1"
        },
        {
            "Name": "surf_air_acceleration",
            "DefaultValue": "9000"
        },
        {
            "Name": "surf_restore_wallrun",
            "DefaultValue": "0"
        },
        {
            "Name": "surf_previous_air_accelerate",
            "DefaultValue": ""
        },
        {
            "Name": "surf_double_jump",
            "DefaultValue": "1"
        }
    ],
    "Scripts": [
        {
            "Path": "gamemodes/sh_gamemode_surf.nut",
            "RunOn": "(SERVER || CLIENT) && MP",
            "ServerCallback": {
                "Before": "Surf_Init"
            },
            "ClientCallback": {
                "Before": "Surf_Init"
            }
        },
        {
            "Path": "gamemodes/_gamemode_surf.nut",
            "RunOn": "SERVER && MP",
            "ServerCallback": {
                "After": "Surf_InitPlayerMovement"
            }
        },
        {
            "Path": "gamemodes/cl_gamemode_surf.nut",
            "RunOn": "CLIENT && MP"
        }
    ],
    "Localisation": [
        "resource/surf_%language%.txt"
    ]
}
